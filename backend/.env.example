DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:15432/fire_monitoring
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# EMQX local/default. If you use Mosquitto from infrastructure, keep localhost:1883.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=fire-monitoring-backend
MQTT_TOPIC_PREFIX=fire
ESP32_DEVICE_CODE=esp32-s3-01
AUTO_PUMP_ON_AI_FIRE=false
DUAL_CONFIRMED_PUMP_ENABLED=true
DUAL_CONFIRMED_PUMP_COOLDOWN_SECONDS=30
