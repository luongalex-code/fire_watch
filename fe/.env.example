# FireWatch API backend
VITE_API_BASE_URL="http://127.0.0.1:8000"
VITE_CAMERA_SERVICE_URL="http://127.0.0.1:8090"
VITE_CAMERA_STREAM_URL="http://127.0.0.1:8090/stream"
# Vercel + local backend: these URLs work only on the computer running the services.
# Remote devices require reachable, protected endpoints; see docs/vercel-deployment.md.
VITE_PUMP_AUTO_ON_DELAY_MS=4000
VITE_PUMP_AUTO_OFF_DELAY_MS=4000
