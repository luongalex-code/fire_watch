# Fire-Watch frontend on Vercel. Public configuration only; no backend secrets.
# Frontend origin: https://fire-watch-self.vercel.app
# Backend URL remains blank until authenticated public access is configured.
# Camera stays on the computer opening the browser; no public camera tunnel.
# Base URLs: no /api, no /ws and no trailing slash.
VITE_API_BASE_URL=
VITE_CAMERA_SERVICE_URL=http://127.0.0.1:8090
VITE_CAMERA_STREAM_URL=http://127.0.0.1:8090/stream

# Optional: same defaults as the current frontend code.
VITE_PUMP_AUTO_ON_DELAY_MS=4000
VITE_PUMP_AUTO_OFF_DELAY_MS=4000
VITE_SENSOR_FIRE_CONFIRM_WINDOW_MS=10000
VITE_PERSON_TTS_MAX_AGE_SECONDS=3
VITE_PIPER_TTS_LENGTH_SCALE=0.95
VITE_PIPER_TTS_SENTENCE_SILENCE=0.35
